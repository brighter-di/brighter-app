# Backend (../backend, Go). Dev uses the Vite /api proxy (BACKEND_URL, default
# http://localhost:3200); a production build points straight at the backend.
# VITE_API_URL=https://brighter-api.example.com

# Optional — enables WalletConnect for mobile wallets. Public-safe project id
# from https://cloud.reown.com. Browser wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# LI.FI funding gateway. Server-only: never prefix this secret with VITE_.
# Copy to .env.local for development; set as a Vercel variable in production.
LIFI_API_KEY=

# Private Solana mainnet RPC URLs used by the funding widget's server proxy.
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=
